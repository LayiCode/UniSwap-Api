# UniSwap environment template.
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env   (then edit .env)
# docker compose reads .env automatically; the backend/app read these as
# environment variables. Never commit a filled-in .env.

# --- Database (PostgreSQL) ------------------------------------------------
DB_USERNAME=uniswap
DB_PASSWORD=change-me-db-password
# DB_DDL_AUTO=update for dev; use Flyway + 'validate' in production

# --- Backend JWT -----------------------------------------------------------
# Generate a strong one:  openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string

# --- Public URLs -----------------------------------------------------------
# Set these to your real public origins once deployed.
APP_BASE_URL=http://localhost:8080/uploads
APP_FRONTEND_URL=http://localhost:3000
APP_BACKEND_URL=http://localhost:8080

# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (Brevo / Resend SMTP) -------------------------------------------
# Leave MAIL_HOST empty to print codes to the backend log instead of emailing.
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# A sender you've verified with the provider (NOT the SMTP login).
MAIL_FROM=

# --- Google "Sign in with..." ----------------------------------------------
# Leave empty to hide the button. See README for creating the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
